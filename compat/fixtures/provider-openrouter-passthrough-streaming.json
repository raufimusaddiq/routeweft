{
  "id": "provider-openrouter-passthrough-streaming",
  "protocol": "openai-chat",
  "kind": "streaming",
  "description": "Dynamic passthrough gateway (OpenRouter-style) with a vendor-prefixed model id; the stream must relay byte-for-byte and terminate exactly once.",
