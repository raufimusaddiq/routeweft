    "body": "data: {\"id\":\"chatcmpl-or-fixture\",\"object\":\"chat.completion.chunk\",\"created\":1735689600,\"model\":\"anthropic/claude-sonnet-4\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\",\"content\":\"Hi\"}}]}\n\ndata: {\"id\":\"chatcmpl-or-fixture\",\"object\":\"chat.completion.chunk\",\"created\":1735689600,\"model\":\"anthropic/claude-sonnet-4\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":5,\"completion_tokens\":1,\"total_tokens\":6}}\n\ndata: [DONE]\n\n"
  },
  "usage": {
