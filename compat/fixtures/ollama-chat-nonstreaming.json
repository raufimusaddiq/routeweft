{
  "id": "ollama-chat-nonstreaming",
  "protocol": "ollama",
  "kind": "non-streaming",
  "description": "Ollama /api/chat non-stream response with prompt/eval accounting.",
  "request": {
    "method": "POST",
    "path": "/api/chat",
    "headers": {
      "content-type": "application/json"
    },
    "body": "{\"model\":\"llama3.2\",\"messages\":[{\"role\":\"user\",\"content\":\"Say hi.\"}],\"stream\":false,\"options\":{\"temperature\":0.2}}"
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "body": "{\"model\":\"llama3.2\",\"created_at\":\"2025-01-01T00:00:00Z\",\"message\":{\"role\":\"assistant\",\"content\":\"Hi.\"},\"done\":true,\"total_duration\":50000000,\"load_duration\":10000000,\"prompt_eval_count\":8,\"eval_count\":2}"
  },
  "usage": {
    "inputTokens": 8,
    "outputTokens": 2
  }
}
