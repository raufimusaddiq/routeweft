{
  "id": "systemone-cloudflare-streaming",
  "protocol": "systemone",
  "kind": "streaming",
  "description": "Synthetic Cloudflare System One SSE wrapper; upstream events and terminal remain opaque to relay.",
  "request": {
    "method": "POST",
    "path": "/v1/systemone",
    "body": "{\"model\":\"@cf/cloudflare/clef-flash\",\"state\":null,\"questions\":{\"future\":true},\"stream\":true}"
  },
  "response": {
    "status": 200,
    "headers": {"content-type": "text/event-stream"},
    "body": "data: {\"result\":{\"answers\":{\"future\":true}}}\n\ndata: {\"result\":{\"usage\":{\"input_tokens\":18,\"output_tokens\":2}}}\n\ndata: [DONE]\n\n"
  },
  "terminal": "data: [DONE]",
  "usage": {"inputTokens": 18, "outputTokens": 2}
}
